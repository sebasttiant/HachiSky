{
  "name": "hachisky-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
