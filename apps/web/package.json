{
  "name": "hachisky-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.18",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
